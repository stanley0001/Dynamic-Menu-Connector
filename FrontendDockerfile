# Build Stage
FROM node:16-alpine as build-stage

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build  # Or npm build

# Production Stage (Nginx)
FROM nginx:alpine

COPY --from=build-stage /app/.next /usr/share/nginx/html
COPY --from=build-stage /app/next.config.js /usr/share/nginx/html # If needed

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
